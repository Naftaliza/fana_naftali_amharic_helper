# Copy to .env.local for local development.
NEXT_PUBLIC_API_URL=http://localhost:5080

# Absolute site URL, used to build Open Graph/Twitter share-card URLs (metadataBase).
# Set to the real Netlify/production URL before sharing links publicly.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Feature flag: Wallet/credits/gifting UI (nav links, /wallet, /gift, /redeem). Hidden by
# default — there's no real payment rail yet (credits are still granted manually, out-of-band).
# Inlined at BUILD time, not read at runtime — set this and rebuild to turn it on, see
# lib/featureFlags.ts.
NEXT_PUBLIC_FEATURE_WALLET=false
