# Copy to .env and adjust. Used by docker-compose and local runs.
ConnectionStrings__Default=Server=localhost,1433;Database=AmharicHelper;User Id=sa;Password=Your_strong_Pass123;TrustServerCertificate=True;Encrypt=False
Jwt__Secret=CHANGE_ME_super_secret_key_at_least_32_chars_long_12345

# AI provider: Claude (default) or OpenAI
Ai__Provider=Claude
ANTHROPIC_API_KEY=
Ai__OpenAiApiKey=

# OCR provider: Mock (default), Google, or Azure
Ocr__Provider=Mock

# Text-to-speech. Provider: Azure (native Amharic voices) or ElevenLabs.
TTS_PROVIDER=Azure

# Azure AI Speech (recommended — supports Amharic, Hebrew, English)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ElevenLabs (fallback — no native Amharic TTS)
ELEVENLABS_API_KEY=
