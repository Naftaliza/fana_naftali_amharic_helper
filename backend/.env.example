# Copy to .env and adjust. Only relevant when running the API directly (`dotnet run`) outside
# Docker — docker-compose.yml hardcodes its own Postgres connection string and does not read this
# file for it.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=AmharicHelper;Username=fana;Password=fana_local_pass
Jwt__Secret=CHANGE_ME_super_secret_key_at_least_32_chars_long_12345

# AI provider: Claude (default) or OpenAI
Ai__Provider=Claude
ANTHROPIC_API_KEY=
Ai__OpenAiApiKey=

# OCR provider: Mock (default), Google, or Azure
Ocr__Provider=Mock

# Text-to-speech. Provider: Azure (native Amharic voices) or ElevenLabs.
TTS_PROVIDER=Azure

# Azure AI Speech (recommended — supports Amharic, Hebrew, English)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# ElevenLabs (fallback — no native Amharic TTS)
ELEVENLABS_API_KEY=

# Comma-separated emails that get admin access (provider/lead/organization consoles).
# Must match the email of a registered Fana account.
Admin__Emails=

# Allowed frontend origin(s) for CORS — comma-separated if more than one.
Frontend__Origin=http://localhost:3001

# Account lockout after repeated failed logins (on top of the per-IP rate limiter).
Auth__MaxFailedLoginAttempts=5
Auth__LockoutMinutes=15

# Password-reset / invoice emails via SMTP (MailKit). Only used when Email__Provider=Smtp.
Email__Smtp__Host=smtp.sendgrid.net
Email__Smtp__Port=587
Email__Smtp__Username=apikey
Email__Smtp__Password=
Email__Smtp__From=
